{
 "title": "Startup Intelligence: operations",
 "uid": "startup-intel-ops",
 "schemaVersion": 39,
 "version": 2,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Worker heartbeat age",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "worker_heartbeat_age_seconds",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 180
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Sources healthy",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "source_health{state=\"HEALTHY\"}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Sources unavailable",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(source_health{state=\"UNAVAILABLE\"}) or vector(0)",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Companies",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "company_discovered_total",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Verified funding rounds",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "funding_verified_total",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Job events",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "jobs_discovered_total",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Events stored per hour (top 10 sources)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "topk(10, increase(source_events_received_total[1h]))",
     "legendFormat": "{{source}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Failed polls per 6 h (top 10 sources)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "topk(10, increase(source_http_errors_total[6h]) > 0)",
     "legendFormat": "{{source}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Job queue",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "job_queue_pending",
     "legendFormat": "pending {{kind}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "expr": "job_queue_failed",
     "legendFormat": "dead {{kind}}",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Alert deliveries by state",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "alert_deliveries",
     "legendFormat": "{{status}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "type": "table",
   "title": "Time since last successful poll (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "time() - source_last_success_timestamp",
     "instant": true,
     "format": "table",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Value",
        "desc": true
       }
      ]
     }
    }
   ]
  },
  {
   "id": 12,
   "type": "table",
   "title": "Detection latency per source, median (s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "source_detection_latency_seconds",
     "instant": true,
     "format": "table",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Value",
        "desc": true
       }
      ]
     }
    }
   ]
  }
 ],
 "tags": [
  "startup-intel"
 ]
}