# Copy to .env (never commit .env). Real values come from scripts/db_setup.sh output.
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DISPLAY_TIMEZONE=Asia/Kolkata
DATABASE_URL=postgresql+asyncpg://startup_intel:CHANGE_ME@127.0.0.1:5432/startup_intel
# Telegram (empty token = alerts print to the console). Topic ids are the message_thread_id of each topic.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_IDS={}
TELEGRAM_OWNER_ID=
LLM_ENABLED=false
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_EMBED_BASE_URL=http://127.0.0.1:8081/v1
LLM_MODEL=qwen3.5-4b
# SEC EDGAR requires contact details in the User-Agent; the SEC route stays off until this is set.
SEC_CONTACT_EMAIL=
# Alerts inbox (IMAP). For Gmail: enable 2-step verification, then create an app password. Leave empty to keep the email route off.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Phase 8. AUTO_SOURCE_CAP: how many discovered company feeds/careers pages may be switched on automatically (0 = none).
AUTO_SOURCE_CAP=0
# GitHub: optional token (public repos need no scopes). Without one the route is limited to 60 requests/hour.
GITHUB_TOKEN=
# Jooble: stays off until the key is set AND jooble.terms_confirmed is true in config/sources.yaml.
JOOBLE_API_KEY=
JOOBLE_BASE_URL=https://jooble.org/api
